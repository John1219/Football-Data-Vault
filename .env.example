# PostgreSQL (inside Docker network)
POSTGRES_DB=football_vault
POSTGRES_USER=vault_admin
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_HOST_PORT=5433

# Storage paths (inside container)
DUCKDB_PATH=/data/duckdb/vault.duckdb
PARQUET_ROOT=/data/parquet
MEDIA_ROOT=/data/media

# NFL (nflverse / nflreadpy - no API key required)
NFL_SEASONS=2023,2024,2025

# College Football Data (https://collegefootballdata.com/key)
CFBD_API_KEY=
CFB_SEASONS=2024,2025

# Fantasy (Sleeper - https://docs.sleeper.com/ - no API key required)
SLEEPER_USERNAME=
SLEEPER_LEAGUE_IDS=

# Optional background auto-sync scheduler
AUTO_SYNC_ENABLED=false
AUTO_SYNC_INTERVAL_HOURS=24
